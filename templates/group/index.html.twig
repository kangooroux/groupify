{% extends 'base.html.twig' %}
{% block title %}Commander pod tables randomizer{% endblock %}
{% block body %}
<button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch theme"></button>
<main class="container" id="main-content" tabindex="-1">
    <h1>Commander pod tables randomizer</h1>

    {% for message in app.flashes('warning') %}
    <p class="flash flash--warning" role="alert">{{ message }}</p>
    {% endfor %}

    <form method="post" action="{{ path('app_group') }}" class="form form--chips" id="pod-form">
        <input type="hidden" name="_token" value="{{ csrfToken }}">

        <fieldset class="form__fieldset">
            <legend class="form__legend">Custom tables <span class="form__hint">(optional — <span class="form__hint--accent">max 4 players each</span>)</span></legend>
            <div id="custom-tables" class="custom-tables"></div>
        </fieldset>
        <button type="button" id="add-table" class="form__add">+ Add custom table</button>

        <fieldset class="form__fieldset">
            {% set remainingNames = rawInput|split("\n")|map(name => name|trim)|filter(name => name) %}
            <div class="rp-head">
                <label class="form__label">Remaining players <span class="form__hint">(type a name and press Enter, or paste a list)</span></label>
                <span class="rp-count" id="remaining-count">{{ remainingNames|length }} in pool</span>
            </div>
            <div id="remaining-chips" class="chips chips--stack">
                {% for name in remainingNames %}
                <span class="chip" data-name="{{ name }}">{{ name }} <button type="button" aria-label="Remove {{ name }}">×</button></span>
                {% endfor %}
                <input type="text" class="chips__input" placeholder="Add player…" aria-label="Add remaining player">
            </div>
        </fieldset>

        <div class="form__actions">
            <button type="submit" name="action" value="{{ round == 0 ? 'randomize' : 'next_round' }}" class="form__submit" id="form-submit">{{ round == 0 ? 'Randomize' : 'Next Round' }}</button>
            {% if round > 0 %}
            <button type="submit" name="action" value="reset" class="form__reset">Reset</button>
            {% endif %}
        </div>
    </form>

    {% if groups is not empty %}
    <section class="results" aria-labelledby="results-heading">
        <div class="results__header">
            <div>
                <h2 id="results-heading">Round {{ round }} — Tables</h2>
                <p class="results__subtitle">{{ "now"|date("l · F j, Y") }} · Commander pods</p>
            </div>
            <a href="{{ path('app_group_print') }}" target="_blank" rel="noopener noreferrer" class="results__print">Print</a>
        </div>
        <div class="summary-stats">
            <div class="stat">
                <div class="stat__value">{{ playerTable|length }}</div>
                <div class="stat__label">Players</div>
            </div>
            <div class="stat">
                <div class="stat__value">{{ groups|length }}</div>
                <div class="stat__label">Pods</div>
            </div>
        </div>
        <div class="results__layout">
            <div class="groups">
                {% for group in groups %}
                <div class="group">
                    <div class="group__header">
                        <h3 class="group__title"><span class="group__badge" aria-hidden="true">{{ loop.index }}</span>Table {{ loop.index }}</h3>
                        <span class="group__count">{{ group|length }} players</span>
                    </div>
                    <ul class="group__list">
                        {% for player in group %}
                        <li class="group__player">{{ player }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endfor %}
            </div>
            <div class="roster">
                <h3 class="roster__heading">Players</h3>
                {% set names = playerTable|keys %}
                {% set half = (names|length / 2)|round(0, 'ceil') %}
                <div class="roster__columns">
                    <ul class="roster__list">
                        {% for name in names|slice(0, half) %}
                        <li class="roster__item">
                            <span class="roster__name">{{ name }}</span>
                            <span class="roster__table">Table {{ playerTable[name] }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                    <ul class="roster__list">
                        {% for name in names|slice(half) %}
                        <li class="roster__item">
                            <span class="roster__name">{{ name }}</span>
                            <span class="roster__table">Table {{ playerTable[name] }}</span>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>
    {% endif %}
</main>
<script src="{{ asset('js/app.js') }}" type="module"></script>
{% endblock %}
